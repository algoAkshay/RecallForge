GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional override. Remove this line to use the application default.
MODEL=google_genai:gemini-3.5-flash-lite

# Optional durable-state root. Render should use /var/data; local development
# defaults to .storage when this is unset.
# RECALLFORGE_STORAGE_DIR=/var/data
